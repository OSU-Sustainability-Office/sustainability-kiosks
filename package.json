    "lint:check": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "axios": "^1.9.0",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.5.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.93.2",
    "vite": "^7.1.12"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
