{
  "name": "sustainability_kiosk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-stage": "vite build --mode staging",
    "lint": "eslint --fix src",
    "prettier": "prettier --write \"**/*.{js,json,html,md,css,scss,vue}\"",
    "format": "npm-run-all --continue-on-error prettier \"lint -- --fix\"",
    "format:check": "npm-run-all prettier:check lint:check",
